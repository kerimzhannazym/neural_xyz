:root {
  color-scheme: light;
  font-family: "Inter", "Segoe UI", system-ui, sans-serif;
  --bg: #f4f7fb;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --primary: #3b82f6;
  --accent: #14b8a6;
  --border: #e2e8f0;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
}

.page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 24px 48px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.hero {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
  align-items: start;
}

.eyebrow {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 8px;
}

h1 {
  margin: 0 0 12px;
  font-size: 2.4rem;
}

.subtitle {
  margin: 0;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.6;
}

.hero-card {
  background: var(--card);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  border: 1px solid var(--border);
}

.hero-card h2 {
  margin-top: 0;
}

.hero-card ol {
  padding-left: 20px;
  margin: 12px 0 20px;
  color: var(--muted);
}

.panel {
  background: var(--card);
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
}

.panel.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  margin-top: 12px;
}

textarea {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 12px;
  margin-top: 16px;
  font-family: "Fira Code", "Courier New", monospace;
}

button {
  border: none;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  cursor: pointer;
}

button.primary {
  background: var(--primary);
  color: white;
}

button.ghost {
  background: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 16px;
}

.summary div {
  background: #f8fafc;
  border-radius: 12px;
  padding: 12px;
  border: 1px solid var(--border);
}

.summary span {
  color: var(--muted);
  font-size: 0.85rem;
}

.summary strong {
  font-size: 1.6rem;
  display: block;
  margin-top: 4px;
}

canvas {
  width: 100%;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid var(--border);
}

.table-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  color: white;
}

.tag-x { background: #22c55e; }
.tag-y { background: #f59e0b; }
.tag-z { background: #ef4444; }

.table-muted {
  color: var(--muted);
}

footer {
  text-align: center;
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 20px;
}

@media (max-width: 960px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .panel.grid {
    grid-template-columns: 1fr;
  }

  .summary {
    grid-template-columns: repeat(2, 1fr);
  }
}
